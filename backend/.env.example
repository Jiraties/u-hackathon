# Copy to .env; never put private keys or API tokens into VITE_* variables.
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=fairpass
CORS_ORIGIN=http://localhost:5173
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
# Fill these from deploy output:
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0
# Separate funded institutional accounts. Student accounts have NO blockchain keys.
ADMIN_PRIVATE_KEY=
ADMIN_ADDRESS=
AUTHORITY_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
# Generate three different values with: openssl rand -hex 32
ADMIN_API_TOKEN=
INTEGRATION_API_TOKEN=
ISSUER_API_TOKEN=
# Fictional demo only; >=12 characters:
DEMO_PASSWORD=

# One institution is mapped to the configured issuer signer.
INSTITUTION_ID=fairpass-demo
# Fictional browser accounts; used only by provision:demo. Set a unique 12+ character password.
# DEMO_PASSWORD=replace-with-a-unique-demo-password

# Public display label; does not establish university affiliation.
INSTITUTION_NAME=Example University

# 0 directly; hosted Caddy -> Nginx -> API uses 2, only on private networking.
TRUST_PROXY_HOPS=0

# Browser sign-in: 7 days by default (maximum 30 days). Generate a dedicated
# secret using openssl rand -hex 32. Never expose it through VITE_* variables.
# If omitted, a domain-separated key is derived from ADMIN_API_TOKEN.
# Changing either signing key invalidates existing browser JWTs.
# SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=604800

# Opt-in v2: requires NEW verifier + registry deployment and separate database.
REGISTRY_VERSION=1
# Public examination authority address for deploy-zk (NOT its private key):
# EXAM_AUTHORITY_ADDRESS=
# Keep EXAM_AUTHORITY_PRIVATE_KEY only in the examination-authority CLI environment.

# Public replay service: no signing keys; keep presenter service separate.
# DEMO_READ_ONLY=true
# ISSUER_ADDRESS=<public institutional issuer address>
# DEMO_REPLAY_MANIFEST=/path/to/reviewed-public-evidence.json
# With DEMO_READ_ONLY=true omit ISSUER_PRIVATE_KEY and AUTHORITY_PRIVATE_KEY entirely.
